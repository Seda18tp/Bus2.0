{
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.7.3" },
    "*.php": { "runtime": "vercel-php@0.7.3" },
    "admin/*.php": { "runtime": "vercel-php@0.7.3" },
    "conductor/*.php": { "runtime": "vercel-php@0.7.3" },
    "estudiante/*.php": { "runtime": "vercel-php@0.7.3" }
  },
  "rewrites": [
    { "source": "/((?!api/|admin/|conductor/|estudiante/|includes/).*)", "destination": "/$1" }
  ]
}
